<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Application properties -->
    <property name="APP_NAME" value="PocketPay"/>
    <property name="LOG_DIR" value="logs"/>


    <!-- Console: balanced colors with trace and span IDs -->
    <property name="CONSOLE_PATTERN"
              value="%gray(%d{yyyy-MM-dd HH:mm:ss.SSS}) %-5level %gray([%thread]) %white([${APP_NAME}]) %cyan([TRACE:%X{traceId:-N/A}]) %magenta([SPAN:%X{spanId:-N/A}]) %white(%logger{36}) %gray(-) %msg%n%ex"/>

    <!-- File: plain text, no ANSI colors -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [PID:${PID:-unknown}] [%thread] [TRACE:%X{traceId:-N/A}] [SPAN:%X{spanId:-N/A}] %logger{36} - %msg%n%ex"/>

    <!-- Console appender -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <withJansi>false</withJansi>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

    </appender>

    <!-- Rolling application log -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/pocketpay.log</file>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>${LOG_DIR}/archive/pocketpay-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <!-- Reduce framework logging noise -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>

    <!-- Application logging -->
    <logger name="com.pocketpay" level="INFO"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
